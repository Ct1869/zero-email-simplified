FROM node:22-alpine AS base

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/mail/package.json ./apps/mail/
COPY packages ./packages

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/mail ./apps/mail
COPY .env* ./

# Build the application
WORKDIR /app/apps/mail
ARG VITE_PUBLIC_APP_URL
ARG VITE_PUBLIC_BACKEND_URL
ENV VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL
ENV VITE_PUBLIC_BACKEND_URL=$VITE_PUBLIC_BACKEND_URL

RUN pnpm build

# Production stage
FROM node:22-alpine

# Install pnpm and serve
RUN corepack enable && corepack prepare pnpm@latest --activate && \
    npm install -g serve

WORKDIR /app

# Copy built application
COPY --from=base /app/apps/mail/build ./build

# Expose port
EXPOSE 3000

# Start the application
CMD ["serve", "-s", "build", "-l", "3000"]

