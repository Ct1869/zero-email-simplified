# Application URLs
VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_BACKEND_URL=http://localhost:8787

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zerodotemail"

# Authentication - Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=my-better-auth-secret
BETTER_AUTH_URL=http://localhost:3000
COOKIE_DOMAIN="localhost"

# Google OAuth (Required for Gmail)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Required for Outlook)
# Get from: https://portal.azure.com/
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Proton Mail (Optional)
# Generate app-specific password in Proton Mail settings
PROTON_APP_PASSWORD=

# Redis (for caching and sessions)
REDIS_URL="http://localhost:8079"
REDIS_TOKEN="upstash-local-token"

# Email Sending (Optional - for transactional emails like welcome emails)
RESEND_API_KEY=

# Encryption (Optional - for additional security)
AUTUMN_SECRET_KEY=

# Environment
NODE_ENV="development"
PORT=8787

